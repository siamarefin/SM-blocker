{
  "manifest_version": 3,
  "name": "SM Blocker",
  "version": "1.0.0",
  "description": "Blocks Facebook after 5 minutes.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://www.youtube.com/*",
    "https://www.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
    },
  "content_scripts": [
  {
    "matches": [
      "https://www.facebook.com/*",
      "https://www.youtube.com/*",
      "https://www.google.com/*"
    ],
    "js": [
      "services/imageBlur.js",
      "content.js"
    ]
  }
],
  "action": {
    "default_popup": "popup.html"
  }
}