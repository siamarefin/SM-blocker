{
  "manifest_version": 3,
  "name": "SM Blocker",
  "version": "1.0.0",
  "description": "Blocks Facebook after 5 minutes.",

  "permissions": [
    "storage",
    "alarms"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "services/imageBlur.js"
      ]
    }
  ],

  "action": {
    "default_popup": "popup.html"
  }
}